---
import SiteLayout from '../../layouts/SiteLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import PDFThumbnail from '$lib/components/PDFThumbnail.svelte';
import { getSlides } from '$lib/server/slides';

const slides = getSlides();
const image = '/images/Microsoft-Fluentui-Emoji-3d-Package-3d.1024.png';
const title = 'スライド一覧';
const description = 'LT会で使ったスライドをまとめています';
---

<SiteLayout {title} {description} {image}>
  <SiteHeader {title} {image} />
  <main class="container px-3 lg:px-12 py-10 mx-auto">
    {slides.length === 0 ? (
      <p class="text-gray-600">スライドがありません</p>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {slides.map((slide) => (
          <div class="card shadow-md hover:shadow-lg transition-shadow">
            <a href={`/slides/${slide.id}`}>
              <PDFThumbnail url={slide.url} client:visible />
            </a>
          </div>
        ))}
      </div>
    )}
  </main>
</SiteLayout>
