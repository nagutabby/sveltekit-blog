# HTTPサーバーのリッスンアドレス。既定値は :8080
BACKEND_ADDR=:8080

# ContentServiceが読むMarkdownソースのディレクトリ。既定値は content (backend/content)
CONTENT_DIR=content

# お問い合わせフォームの送信先(Mailtrap)
EMAIL_API_TOKEN=
FROM_ADDRESS=
BCC_ADDRESS=

# Postgres接続文字列(Follower/RelayConnection)
DATABASE_URL=

# ActivityPub actorのドメイン。既定値は https://blog.nagutabby.uk
SITE_BASE_URL=https://blog.nagutabby.uk

# /actor/outboxが記事数を数えるために/atom.xmlを取得するweb(Sve時はSITE_BASE_URLと同じ値を使う
WEB_BASE_URL=

# actorの鍵ペア(署名付きActivityの送受信に使う)。改行は \n でエスケープしてよい
ACTOR_PUBLIC_KEY_PEM=
ACTOR_PRIVATE_KEY_PEM=
