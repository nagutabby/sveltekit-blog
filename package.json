{
  "name": "sveltekit-blog",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "prepare": "svelte-kit sync",
    "dev": "vite dev",
    "build": "prisma generate && vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test:unit": "vitest",
    "test": "pnpm test:unit run"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260811.1",
    "@idotj/mastodon-embed-timeline": "^4.8.2",
    "@prisma/client": "^6.6.0",
    "@sveltejs/adapter-node": "^5.2.12",
    "@sveltejs/kit": "^2.20.7",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/highlightjs": "^9.12.6",
    "@types/lodash.memoize": "^4.1.9",
    "canonicalize": "^3.0.0",
    "daisyui": "^5.7.16",
    "fast-xml-parser": "^5.10.1",
    "gray-matter": "^4.0.3",
    "jsdom": "^30.0.1",
    "lodash.memoize": "^4.1.2",
    "marked": "^18.0.9",
    "marked-gfm-heading-id": "^4.1.4",
    "marked-katex-extension": "^5.1.10",
    "msw": "^2.15.0",
    "pdfjs-dist": "^6.2.108",
    "postcss": "^8.5.26",
    "prisma": "^6.6.0",
    "sass": "^1.102.0",
    "sharp": "^0.35.3",
    "shiki": "^4.4.3",
    "svelte": "^5.56.8",
    "svelte-check": "^4.1.5",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.1",
    "vitest": "^3.1.1",
    "wrangler": "^4.120.1"
  },
  "type": "module",
  "packageManager": "pnpm@10.11.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "msw",
      "prisma",
      "sharp",
      "workerd"
    ]
  }
}
